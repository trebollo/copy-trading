generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  tradingAccounts TradingAccount[]
  copyGroups      CopyGroup[]
  preferences     UserPreferences?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TradingAccount {
  id        String   @id @default(cuid())
  userId    String
  name      String
  platform  String
  accountId String
  apiKey    String?
  apiSecret String?
  balance   Float    @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades           Trade[]
  dailyMetrics     DailyMetric[]
  copyGroupMembers CopyGroupMember[]
  masterOfGroups   CopyGroup[]       @relation("MasterAccount")

  @@index([userId])
}

model CopyGroup {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String?
  masterAccountId String
  webhookSecret   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterAccount TradingAccount    @relation("MasterAccount", fields: [masterAccountId], references: [id])
  members       CopyGroupMember[]

  @@index([userId])
}

model CopyGroupMember {
  id               String  @id @default(cuid())
  groupId          String
  tradingAccountId String
  riskMultiplier   Float   @default(1.0)
  maxLots          Float?
  maxDailyLoss     Float?
  isActive         Boolean @default(true)

  group          CopyGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tradingAccount TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@unique([groupId, tradingAccountId])
}

model Trade {
  id               String    @id @default(cuid())
  tradingAccountId String
  externalId       String?
  symbol           String
  side             String
  quantity         Float
  price            Float
  pnl              Float?
  status           String    @default("open")
  openedAt         DateTime  @default(now())
  closedAt         DateTime?
  copiedFromId     String?

  tradingAccount TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  copiedFrom     Trade?         @relation("CopiedTrades", fields: [copiedFromId], references: [id])
  copiedTrades   Trade[]        @relation("CopiedTrades")

  @@index([tradingAccountId])
  @@index([copiedFromId])
}

model DailyMetric {
  id               String   @id @default(cuid())
  tradingAccountId String
  date             DateTime @db.Date
  pnl              Float    @default(0)
  trades           Int      @default(0)
  winRate          Float    @default(0)
  avgWin           Float    @default(0)
  avgLoss          Float    @default(0)

  tradingAccount TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  @@unique([tradingAccountId, date])
  @@index([tradingAccountId])
}

model UserPreferences {
  id                    String  @id @default(cuid())
  userId                String  @unique
  defaultRiskMultiplier Float   @default(1.0)
  timezone              String  @default("America/New_York")
  darkMode              Boolean @default(false)
  notifyTradeCopied     Boolean @default(true)
  notifyDailyReport     Boolean @default(true)
  notifyRiskLimitHit    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

# Demo Mode (set to "true" to bypass authentication and use mock data)
DEMO_MODE=true

# Client-side Demo Mode (NEXT_PUBLIC_ prefix exposes this to the browser)
# Set to "true" to show sample/mock data in client components
# Set to "false" or remove to use real API data with empty initial states
NEXT_PUBLIC_DEMO_MODE=true

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/copy_trading

# Encryption (32-byte hex key for AES-256-GCM credential encryption)
ENCRYPTION_KEY=your-64-char-hex-string-here-generate-with-openssl-rand-hex-32

# Tradovate API
TRADOVATE_API_KEY=your-tradovate-api-key
TRADOVATE_API_SECRET=your-tradovate-api-secret
TRADOVATE_API_URL=https://demo.tradovateapi.com/v1
